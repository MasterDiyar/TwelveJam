shader_type canvas_item;

// Прогресс эффекта от 0.0 (закрыто) до 1.0 (полностью прозрачно)
uniform float progress : hint_range(0.0, 1.0) = 0.0;

// Количество блоков-пикселей по сетке (чем меньше число, тем крупнее квадраты)
uniform float grid_size = 40.0; 

void fragment() {
    // Квантуем UV-координаты, создавая эффект пиксельной сетки
    vec2 quantized_uv = floor(UV * grid_size) / grid_size;
    
    // Центр экрана / спрайта
    vec2 center = vec2(0.5, 0.5);
    
    // Вычисляем расстояние от центра для каждого пиксельного блока (+ сдвиг для ровности центра)
    float dist = distance(quantized_uv + vec2(0.5 / grid_size), center);
    
    // Максимальное расстояние от центра до угла экрана (~0.71, берем 0.75 с запасом)
    float max_radius = 0.75;
    
    // Если расстояние меньше текущего радиуса — пиксель становится прозрачным
    if (dist < progress * max_radius) {
        discard; // Полностью удаляет пиксель (или можно использовать COLOR.a = 0.0;)
    } else {
        // Иначе оставляем исходный цвет текстуры
        COLOR = texture(TEXTURE, UV);
    }
}